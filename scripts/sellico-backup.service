[Unit]
Description=Sellico PostgreSQL verified backup
Documentation=https://github.com/panfiloveshow/sellico-ads-intelligence-backend
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=admin_reprice
Group=admin_reprice
WorkingDirectory=/opt/sellico
Environment=BACKUP_USE_DOCKER=1
Environment=COMPOSE_FILE=docker-compose.prod.yml
Environment=BACKUP_TEXTFILE_DIR=/var/lib/node_exporter/textfile
Environment=HOME=/tmp
EnvironmentFile=-/etc/sellico/backup.env
ExecStart=/opt/sellico/scripts/backup-db.sh
UMask=0077
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/sellico/backups /var/lib/node_exporter/textfile
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
